#!/usr/bin/env bash
# Penwise desktop window: makes sure the server runs, then opens the viewer as its own app window.
# The viewer follows the tablet's page by default and takes the token from the server itself (GET /pair/local),
# so there is nothing to type.
set -euo pipefail

port="${PENWISE_PORT:-7420}"
url="http://127.0.0.1:${port}/"

if ! curl -fsS -o /dev/null "${url}pair/local" 2>/dev/null; then
    systemctl --user start penwise.service
    for _ in $(seq 50); do
        curl -fsS -o /dev/null "${url}pair/local" 2>/dev/null && break
        sleep 0.1
    done
fi

browser="${PENWISE_BROWSER:-$(command -v chromium || command -v google-chrome-stable || command -v chromium-browser || true)}"
if [[ -z "$browser" ]]; then
    exec xdg-open "$url"
fi
# Own profile: its own window class (launcher icon, alt-tab entry) and storage, apart from everyday browsing.
exec "$browser" --app="$url" --class=Penwise --user-data-dir="${XDG_DATA_HOME:-$HOME/.local/share}/penwise-app/browser" "$@"
