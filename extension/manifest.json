{
  "manifest_version": 3,
  "name": "Penwise capture",
  "version": "0.1.0",
  "description": "Send a page \u2014 or one element of it \u2014 to the Penwise canvas, ready to annotate on the tablet.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Penwise capture"
  }
}
