<?xml version="1.0" encoding="utf-8"?>
<!--
  Frames load the linked project over plain HTTP: through `adb reverse` it is loopback, otherwise it is the Penwise
  server on the LAN. cleartextTrafficPermitted stays on for both; the named hosts are the ones a frame URL normally
  uses (loopback for `adb reverse`, 10.0.2.2 for an emulator's host) and are spelled out so the intent is explicit.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
